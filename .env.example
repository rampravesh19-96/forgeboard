# Copy to root .env. Never commit .env or real credentials.
POSTGRES_USER=forgeboard
POSTGRES_PASSWORD=forgeboard_local_only
POSTGRES_DB=forgeboard
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://forgeboard:forgeboard_local_only@localhost:5432/forgeboard?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
# API_HOST defaults to loopback locally and 0.0.0.0 in production.
# Hosting-provider PORT takes precedence over API_PORT.
WEB_ORIGIN=http://localhost:3000

# Required: replace with a random value of at least 32 characters.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-before-running
# Explicit opt-in to public demo login as Alex. Not production identity.
DEMO_AUTH_ENABLED=true
# Deterministic seed anchor; affects dates only on initial seed.
DEMO_SEED_DATE=2026-09-16T09:00:00.000Z

# Optional Next.js server-only proxy URL. Set in apps/web/.env.local if changed.
# API_INTERNAL_URL=http://127.0.0.1:4000
# Public Socket.IO namespace URL; set in apps/web/.env.local before building.
# NEXT_PUBLIC_REALTIME_URL=http://localhost:4000/collaboration
# Production: NODE_ENV=production on the API, WEB_ORIGIN=https://your-web-host
# API_INTERNAL_URL=https://your-api-host (web server only)
# NEXT_PUBLIC_REALTIME_URL=https://your-api-host/collaboration (public, build-time)
# Hosted Redis must expose Redis TCP/TLS (redis:// or rediss://), not an HTTP REST URL.
