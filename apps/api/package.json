{
  "name": "@forgeboard/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch --exec \"node --env-file-if-exists=../../.env\"",
    "build": "prisma generate && nest build",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "test:realtime": "pnpm build && node --test test/realtime.test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --env-file=../../.env prisma/seed.cjs",
    "db:studio": "node --env-file=../../.env ./node_modules/prisma/build/index.js studio"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/platform-socket.io": "12.0.3",
    "@nestjs/websockets": "12.0.3",
    "@prisma/client": "6.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@forgeboard/config": "workspace:*",
    "@forgeboard/types": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "12.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "prisma": "6.19.0",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.3"
  }
}
